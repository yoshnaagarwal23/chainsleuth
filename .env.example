# Copy to .env and fill in. Never commit .env.
# Free key: https://etherscan.io/myapikey  (sign up, then "API Keys" -> "Add")
ETHERSCAN_API_KEY=
# Optional, free tier: https://dashboard.alchemy.com  (create an app on Ethereum Mainnet)
ALCHEMY_API_KEY=
# Needed from Phase 7: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Local anvil chain (Phase 1+)
ANVIL_RPC_URL=http://127.0.0.1:8545
